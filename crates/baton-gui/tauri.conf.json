{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskBaton",
  "identifier": "io.github.rossettaylm.deskbaton.panel",
  "build": {
    "frontendDist": "ui",
    "beforeBundleCommand": "bash -c 'bash \"$(git rev-parse --show-toplevel)/scripts/embed-sleep-daemon.sh\"'"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "url": "index.html",
        "title": "DeskBaton",
        "width": 360,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0MTgxNzUwNEQ2QTgzNDIKUldSQ2cycE5VQmNZOUtDTm9JSXdFYWFqODJCQ2xWWnVoUjJSL2R2Q3pLaEFjd3RFcVowaFpXbDAK",
      "endpoints": [
        "https://github.com/Rossettaylm/deskbaton/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["dmg", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/deskbaton-sleep-helper"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
