{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskBaton",
  "identifier": "io.github.rossettaylm.deskbaton.panel",
  "build": {
    "frontendDist": "ui",
    "beforeBundleCommand": "bash -c 'bash \"$(git rev-parse --show-toplevel)/scripts/embed-sleep-daemon.sh\"'"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "url": "index.html",
        "title": "DeskBaton",
        "width": 360,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/deskbaton-sleep-helper"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
